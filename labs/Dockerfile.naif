# Le Dockerfile qu'on ecrit spontanement autour d'un depot qu'on veut « sauver ».
#
# Il est naif de deux facons. Il n'epingle rien -- ni l'image de base au-dela de
# la version mineure de Python, ni une seule des dependances installees : c'est
# le geste que le lab 1 vous demande d'observer, et il ne suffit pas. Et il met
# ses instructions dans l'ordre ou elles viennent a l'esprit plutot que dans
# celui ou elles changent : c'est ce que le lab 3 vous fera mesurer.
#
#   docker build -t autopsie:naif -f labs/Dockerfile.naif .
#   docker run --rm autopsie:naif

FROM python:3.11-slim

WORKDIR /app

# Naif aussi par l'ordre : on copie tout, puis on installe. C'est l'ordre dans
# lequel on ecrit spontanement un Dockerfile, et le lab 3 mesurera ce qu'il
# coute a chaque reconstruction.
COPY labs/2019/ ./

RUN pip install --no-cache-dir -r requirements.txt

CMD ["python", "-m", "automobile.training.train"]
