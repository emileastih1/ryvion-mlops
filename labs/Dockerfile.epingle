# La reparation « epingler le passe » : on ne touche pas au code, on restitue
# l'environnement qui le faisait tourner.
#
# Deux lignes changent par rapport a labs/Dockerfile.naif, et elles disent la
# meme chose : l'image de base est une dependance, exactement comme les paquets.
# Epingler scikit-learn sans epingler Python echoue -- il n'existe pas de roue
# scikit-learn 0.21.3 pour Python 3.11, et le depot n'a rien pour la compiler.
#
#   docker build -t autopsie:epingle -f labs/Dockerfile.epingle .
#   docker run --rm autopsie:epingle

FROM python:3.7-slim

WORKDIR /app

COPY labs/2019/requirements-2019.lock.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY labs/2019/ ./

CMD ["python", "-m", "automobile.training.train"]
